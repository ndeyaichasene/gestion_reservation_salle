{
    "name": "aicha/gestion_reservation_salle",
    "description": "Gestion des réservations de salles universitaires",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\config\\": "config/",
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ndeye Aissatou Sene",
            "email": "ndeyaichasene@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "nikic/fast-route": "^1.3",
        "respect/validation": "^2.4",
        "illuminate/database": "^12.0",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.7",
        "illuminate/pagination": "^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "scripts": {
        "aicha:migrate": "php database/migrate.php",
        "aicha:seed": "php database/seed.php",
        "db:setup": [
            "@aicha:migrate",
            "@aicha:seed"
        ],
        "serve": "php -S 127.0.0.1:8001 -t public",
        "test": "phpunit --testdox"
    }
}
